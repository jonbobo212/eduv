{
  "name": "eduv-mirror",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-contained static mirror of the Eduvisa Consulting site",
  "scripts": {
    "doctor": "node tools/doctor.mjs",
    "capture": "node tools/capture.mjs",
    "harvest": "node tools/harvest.mjs",
    "rewrite": "node tools/rewrite.mjs",
    "copy": "node tools/capture.mjs && node tools/harvest.mjs && node tools/rewrite.mjs",
    "serve": "node tools/serve.mjs",
    "verify": "node tools/verify.mjs",
    "mirror:wget": "bash tools/mirror.sh"
  },
  "devDependencies": {
    "pixelmatch": "^6.0.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "undici": "^8.10.0"
  }
}
